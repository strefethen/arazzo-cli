{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CatalogOutput",
  "description": "Combined schema type for the `catalog` command output: the catalog array or\nthe error object.",
  "anyOf": [
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CatalogEntry"
      }
    },
    {
      "$ref": "#/$defs/ErrorObject"
    }
  ],
  "$defs": {
    "CatalogEntry": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceInfo"
          }
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "workflows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkflowInfo"
          }
        }
      },
      "required": [
        "file",
        "title",
        "version",
        "sources",
        "workflows"
      ]
    },
    "ErrorObject": {
      "description": "Schema-only description of the shared `--json` error object `main` prints\nfrom a `CliError` that carries no extra fields.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "kind": {
          "description": "Always `\"error\"`.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "error",
        "code"
      ]
    },
    "SourceInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "type"
      ]
    },
    "WorkflowInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "inputs",
        "outputs"
      ]
    }
  }
}
