{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunOutput",
  "description": "Combined schema type for the `run` command output.\n\nThe actual shape depends on flags and exit code:\n- `Success`: `{\"kind\":\"success\",\"outputs\":{...},\"warnings\":[...]?}` (exit 0, no `--dry-run`)\n- `Error`: `{\"kind\":\"error\",\"error\":\"...\",\"code\":\"...\",\"warnings\":[...]?}` (non-zero exit)\n- `DryRun`: `{\"kind\":\"dryRun\",\"requests\":[...],\"warnings\":[...]?}` (exit 0, `--dry-run`)",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "success"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": true
        },
        "transportWarnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TransportWarning"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "outputs"
      ]
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "error"
        },
        "transportWarnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TransportWarning"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "error"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "dryRun"
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DryRunRequest"
          }
        },
        "transportWarnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TransportWarning"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "requests"
      ]
    }
  ],
  "$defs": {
    "DryRunRequest": {
      "description": "Captured request emitted during dry-run mode.",
      "type": "object",
      "properties": {
        "body": true,
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "method": {
          "type": "string"
        },
        "stepId": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "stepId",
        "method",
        "url"
      ]
    },
    "TransportWarning": {
      "description": "Structured transport-trust warning. Emitted regardless of the\nstderr squelch (`transport_warnings: false` silences only the\nstderr text): degraded-trust facts are audit data.",
      "type": "object",
      "properties": {
        "hosts": {
          "description": "Hosts or `host[:port]` exception entries the warning names.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "$ref": "#/$defs/TransportWarningKind"
        },
        "message": {
          "description": "Human-readable text (the same line written to stderr).",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    "TransportWarningKind": {
      "description": "Class of a [`TransportWarning`].",
      "oneOf": [
        {
          "description": "TLS verification disabled for the listed `host[:port]` entries.",
          "type": "string",
          "const": "insecureHostsActive"
        },
        {
          "description": "TLS verification disabled for every host (blanket `--insecure`).",
          "type": "string",
          "const": "insecureAllHosts"
        },
        {
          "description": "Authorization/Cookie sent over non-loopback cleartext http.",
          "type": "string",
          "const": "cleartextCredentials"
        },
        {
          "description": "Configured insecure exceptions no request targeted.",
          "type": "string",
          "const": "unusedInsecureHosts"
        }
      ]
    }
  }
}
