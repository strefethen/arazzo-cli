{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StepsOutput",
  "description": "Combined schema type for the `steps` command output: the step array or the\nerror object.",
  "anyOf": [
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StepInfo"
      }
    },
    {
      "$ref": "#/$defs/ErrorObject"
    }
  ],
  "$defs": {
    "ErrorObject": {
      "description": "Schema-only description of the shared `--json` error object `main` prints\nfrom a `CliError` that carries no extra fields.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "kind": {
          "description": "Always `\"error\"`.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "error",
        "code"
      ]
    },
    "StepInfo": {
      "type": "object",
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "channelPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "correlationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "referencedWorkflow": {
          "type": [
            "string",
            "null"
          ]
        },
        "stepId": {
          "type": "string"
        },
        "timeout": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "stepId",
        "position"
      ]
    }
  }
}
