{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/strefethen/arazzo-cli/docs/schemas/trace-v2.schema.json",
  "title": "arazzo trace.v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "run",
    "inputs",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "trace.v2"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": [
        "specPath",
        "workflowId",
        "parallel",
        "dryRun",
        "timeoutMs",
        "startedAt",
        "finishedAt",
        "durationMs",
        "status"
      ],
      "properties": {
        "specPath": {
          "type": "string"
        },
        "workflowId": {
          "type": "string"
        },
        "parallel": {
          "type": "boolean"
        },
        "dryRun": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "number"
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "durationMs": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "failure"
          ]
        },
        "error": {
          "type": "string"
        },
        "transportWarnings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sequentialFallbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "workflowId",
              "reason",
              "message"
            ],
            "properties": {
              "workflowId": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "controlFlowAction",
                  "retryReference",
                  "subWorkflowStep",
                  "debugger",
                  "singleStep"
                ]
              },
              "stepId": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object",
      "description": "JSON workflow inputs. A bytes input is absent here and recorded only in inputBlobs."
    },
    "inputBlobs": {
      "$ref": "#/$defs/blobSlots",
      "description": "Bytes inputs keyed by input name."
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "bytesDescriptor": {
      "description": "The only serialized form of bytes. Content is never recorded.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "size",
            "sha256"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "mediaType": {
              "type": "string"
            },
            "filename": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Fixed marker for a sensitive blob: no size and no hash.",
          "required": [
            "kind",
            "redacted"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "redacted": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "blobSlots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/bytesDescriptor"
      }
    },
    "request": {
      "type": "object",
      "required": [
        "method",
        "url"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "description": "Logical request body. A bytes body or bytes leaf is not represented here; see bodyBlobs."
        },
        "bodyBlobs": {
          "$ref": "#/$defs/blobSlots",
          "description": "Bytes in the request body keyed by JSON Pointer into body: \"\" for a whole-body blob, \"/<part>\" for a multipart part."
        },
        "redirects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "statusCode",
              "from",
              "to"
            ],
            "properties": {
              "statusCode": {
                "type": "integer"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": [
        "statusCode",
        "bodyBytes"
      ],
      "properties": {
        "statusCode": {
          "type": "integer"
        },
        "mediaType": {
          "type": "string",
          "description": "The parsed Content-Type (essence and parameters); absent when the response has none or it does not parse."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "bodyBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Size of the body as received, after transport content decoding."
        },
        "body": {
          "type": "string",
          "description": "Decoded JSON or text body, redacted and truncated to --trace-max-body-bytes."
        },
        "bodyBlob": {
          "$ref": "#/$defs/bytesDescriptor",
          "description": "Descriptor of a bytes body or of a body that failed to decode; its mediaType is the essence of mediaType, without parameters."
        },
        "bodyError": {
          "type": "string",
          "description": "Why a JSON or text body failed to decode."
        },
        "contentType": false,
        "bodyPreview": false,
        "bodyLossy": false
      },
      "not": {
        "required": [
          "body",
          "bodyBlob"
        ]
      },
      "dependentRequired": {
        "bodyError": [
          "bodyBlob"
        ]
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": [
        "seq",
        "workflowId",
        "stepId",
        "attempt",
        "kind",
        "durationMs",
        "decision"
      ],
      "properties": {
        "seq": {
          "type": "number"
        },
        "workflowId": {
          "type": "string"
        },
        "stepId": {
          "type": "string"
        },
        "attempt": {
          "type": "number"
        },
        "kind": {
          "type": "string"
        },
        "operationPath": {
          "type": "string"
        },
        "workflowIdRef": {
          "type": "string"
        },
        "durationMs": {
          "type": "number"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "response": {
          "$ref": "#/$defs/response"
        },
        "criteria": {
          "type": "array"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "outputs": {
          "type": "object",
          "description": "JSON step outputs. A bytes output is absent here and recorded only in outputBlobs."
        },
        "outputBlobs": {
          "$ref": "#/$defs/blobSlots",
          "description": "Bytes step outputs keyed by output name."
        },
        "error": {
          "type": "string"
        },
        "message": {
          "type": "object",
          "description": "The message an AsyncAPI receive step consumed, or simulated in a dry run. Absent for HTTP and workflow steps.",
          "required": [
            "transport",
            "host",
            "topic",
            "partition",
            "offset",
            "timestampMs",
            "payloadBytes"
          ],
          "properties": {
            "transport": {
              "type": "string",
              "enum": [
                "kafka"
              ]
            },
            "host": {
              "type": "string"
            },
            "topic": {
              "type": "string"
            },
            "partition": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "timestampMs": {
              "type": "integer"
            },
            "key": {
              "type": "string"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "payloadBytes": {
              "type": "integer"
            },
            "payloadPreview": {
              "type": "string"
            },
            "payload": {
              "type": "string"
            },
            "payloadLossy": {
              "type": "boolean"
            },
            "simulated": {
              "type": "boolean"
            },
            "correlationId": {
              "type": "string",
              "description": "Resolved expected correlation text; also present on dry-run messages when specified."
            },
            "skippedRecords": {
              "type": "integer",
              "minimum": 0,
              "description": "Decoded non-matching records skipped before this message; omitted when zero."
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
