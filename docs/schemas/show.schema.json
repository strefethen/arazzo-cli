{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShowOutput",
  "description": "Combined schema type for the `show` command output: the workflow detail or\nthe error object.",
  "anyOf": [
    {
      "$ref": "#/$defs/WorkflowDetail"
    },
    {
      "$ref": "#/$defs/ErrorObject"
    }
  ],
  "$defs": {
    "WorkflowDetail": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "step_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepSummary"
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/InputDetail"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceInfo"
          }
        }
      },
      "required": [
        "id",
        "file",
        "title",
        "step_count",
        "steps",
        "inputs",
        "outputs",
        "sources"
      ]
    },
    "StepSummary": {
      "type": "object",
      "properties": {
        "stepId": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "channelPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "correlationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "stepId"
      ]
    },
    "InputDetail": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "required"
      ]
    },
    "SourceInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "type"
      ]
    },
    "ErrorObject": {
      "description": "Schema-only description of the shared `--json` error object `main` prints\nfrom a `CliError` that carries no extra fields.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Always `\"error\"`.",
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "error",
        "code"
      ]
    }
  }
}
