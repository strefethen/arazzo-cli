{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/strefethen/arazzo-cli/docs/schemas/trace-v1.schema.json",
  "title": "arazzo trace.v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "run",
    "inputs",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "trace.v1"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": [
        "specPath",
        "workflowId",
        "parallel",
        "dryRun",
        "timeoutMs",
        "startedAt",
        "finishedAt",
        "durationMs",
        "status"
      ],
      "properties": {
        "specPath": {
          "type": "string"
        },
        "workflowId": {
          "type": "string"
        },
        "parallel": {
          "type": "boolean"
        },
        "dryRun": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "number"
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "durationMs": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "failure"
          ]
        },
        "error": {
          "type": "string"
        },
        "sequentialFallbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "workflowId",
              "reason",
              "message"
            ],
            "properties": {
              "workflowId": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "controlFlowAction",
                  "retryReference",
                  "subWorkflowStep",
                  "debugger",
                  "singleStep"
                ]
              },
              "stepId": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "seq",
          "workflowId",
          "stepId",
          "attempt",
          "kind",
          "durationMs",
          "decision"
        ],
        "properties": {
          "seq": {
            "type": "number"
          },
          "workflowId": {
            "type": "string"
          },
          "stepId": {
            "type": "string"
          },
          "attempt": {
            "type": "number"
          },
          "kind": {
            "type": "string"
          },
          "operationPath": {
            "type": "string"
          },
          "workflowIdRef": {
            "type": "string"
          },
          "durationMs": {
            "type": "number"
          },
          "request": {
            "type": "object"
          },
          "response": {
            "type": "object"
          },
          "criteria": {
            "type": "array"
          },
          "decision": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "outputs": {
            "type": "object"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "object",
            "description": "The message an AsyncAPI receive step consumed, or simulated in a dry run. Absent for HTTP and workflow steps.",
            "required": [
              "transport",
              "host",
              "topic",
              "partition",
              "offset",
              "timestampMs",
              "payloadBytes"
            ],
            "properties": {
              "transport": {
                "type": "string",
                "enum": [
                  "kafka"
                ]
              },
              "host": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "partition": {
                "type": "integer"
              },
              "offset": {
                "type": "integer"
              },
              "timestampMs": {
                "type": "integer"
              },
              "key": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "payloadBytes": {
                "type": "integer"
              },
              "payloadPreview": {
                "type": "string"
              },
              "payload": {
                "type": "string"
              },
              "payloadLossy": {
                "type": "boolean"
              },
              "simulated": {
                "type": "boolean"
              },
              "correlationId": {
                "type": "string",
                "description": "Resolved expected correlation text; also present on dry-run messages when specified."
              },
              "skippedRecords": {
                "type": "integer",
                "minimum": 0,
                "description": "Decoded non-matching records skipped before this message; omitted when zero."
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
