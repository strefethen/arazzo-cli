{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ListOutput",
  "description": "Combined schema type for the `list` command output: the workflow array or\nthe error object.",
  "anyOf": [
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkflowInfo"
      }
    },
    {
      "$ref": "#/$defs/ErrorObject"
    }
  ],
  "$defs": {
    "ErrorObject": {
      "description": "Schema-only description of the shared `--json` error object `main` prints\nfrom a `CliError` that carries no extra fields.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "kind": {
          "description": "Always `\"error\"`.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "error",
        "code"
      ]
    },
    "WorkflowInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "inputs",
        "outputs"
      ]
    }
  }
}
