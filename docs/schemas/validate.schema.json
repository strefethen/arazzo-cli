{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidateOutput",
  "description": "Combined schema type for the `validate` command output: the success shape\nor the error object.",
  "anyOf": [
    {
      "$ref": "#/$defs/ValidateResult"
    },
    {
      "$ref": "#/$defs/ValidateErrorResult"
    }
  ],
  "$defs": {
    "ValidateErrorResult": {
      "description": "Schema-only description of a failing `validate --json` run: the shared\nerror object plus the fields that predate it. `main` prints it from a\n`CliError` built by `validate_error`.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidateIssue"
          }
        },
        "file": {
          "type": "string"
        },
        "kind": {
          "description": "Always `\"error\"`.",
          "type": "string"
        },
        "valid": {
          "description": "Always `false`.",
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidateIssue"
          }
        }
      },
      "required": [
        "kind",
        "error",
        "code",
        "valid",
        "file"
      ]
    },
    "ValidateIssue": {
      "type": "object",
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "message"
      ]
    },
    "ValidateResult": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidateIssue"
          }
        },
        "file": {
          "type": "string"
        },
        "sources": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid": {
          "type": "boolean"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "description": "Non-fatal findings. Present alongside `valid: true`; `--strict`\npromotes them into `errors` instead.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidateIssue"
          }
        },
        "workflows": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "valid",
        "file"
      ]
    }
  }
}
