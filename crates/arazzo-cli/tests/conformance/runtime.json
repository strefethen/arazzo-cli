    {
      "id": "runtime.asyncapi-receive-admission-before-connection",
      "area": "runtime",
      "authority": "arazzoSpec",
      "specAnchors": ["spec/arazzo/v1.1.0.html#defining-success-for-asynchronous-steps", "spec/arazzo/v1.1.0.html#stepAction", "spec/arazzo/v1.1.0.html#step-object"],
      "normativeLevels": ["MAY", "SHOULD"],
      "claim": "AsyncAPI receive-target admission reads the local document before any connection and accepts supported channelPath and operationId targets. Admission refuses send, missing action, requestBody, referenced channel/operation/server objects, templated addresses, strict messages subsets, non-JSON content types, and no eligible server with RUNTIME_UNSUPPORTED_ASYNCAPI_TRANSPORT or RUNTIME_MESSAGE_TRANSPORT_CONFIG without opening a socket.",
      "status": "covered",
      "evidence": {
        "positive": [
          "crates/arazzo-runtime/src/runtime_core/asyncapi_receive_tests.rs#both_target_forms_project_the_same_target"
        ],
        "negative": [
          "crates/arazzo-runtime/src/runtime_core/asyncapi_receive_tests.rs#send_absent_action_and_request_body_are_refused",
          "crates/arazzo-runtime/src/runtime_core/asyncapi_receive_tests.rs#operation_form_refuses_mismatched_action_ref_operations_and_executable_fields",
          "crates/arazzo-runtime/src/runtime_core/asyncapi_receive_tests.rs#a_ref_with_sibling_properties_is_still_a_reference",
          "crates/arazzo-runtime/src/runtime_core/asyncapi_target_tests.rs#unsupported_versions_references_forms_and_remote_uri_fail_explicitly",
          "crates/arazzo-runtime/src/runtime_core/asyncapi_receive_tests.rs#address_must_be_a_literal_topic",
          "crates/arazzo-runtime/src/runtime_core/asyncapi_receive_tests.rs#operation_messages_must_list_every_channel_message",
          "crates/arazzo-runtime/src/runtime_core/asyncapi_receive_tests.rs#effective_content_type_follows_message_then_traits_then_default",
          "crates/arazzo-runtime/src/runtime_core/asyncapi_receive_tests.rs#channel_servers_subset_root_fallback_and_selection",
          "crates/arazzo-runtime/tests/kafka_receive_engine.rs#send_missing_correlation_object_and_replay_fail_before_any_connection",
          "crates/arazzo-runtime/tests/kafka_receive_engine.rs#an_unsupported_later_target_is_refused_before_the_first_one_connects"
        ]
      }
    },
