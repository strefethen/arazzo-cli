    {
      "id": "runtime.asyncapi-send-unsupported",
      "area": "runtime",
      "authority": "arazzoSpec",
      "specAnchors": ["spec/arazzo/v1.1.0.html#defining-success-for-asynchronous-steps", "spec/arazzo/v1.1.0.html#stepAction"],
      "normativeLevels": ["MAY"],
      "claim": "An AsyncAPI action: send step sends a message to its channel and completes immediately after the message is sent.",
      "status": "unsupported",
      "owner": "ac-1a498",
      "reason": "The specification does not say where a send step's payload comes from (OAI/Arazzo-Specification#617, recorded open on 2026-10-28). The runtime refuses action: send with RUNTIME_UNSUPPORTED_ASYNCAPI_TRANSPORT before any connection; ac-1a498 owns support pending the outgoing-message contract.",
      "evidence": {
        "negative": [
          "crates/arazzo-runtime/tests/kafka_receive_engine.rs#send_missing_correlation_object_and_replay_fail_before_any_connection"
        ]
