{
  "area": "runtime",
  "claims": [
    {
      "id": "runtime.xpath-version-dispatch",
      "area": "runtime",
      "authority": "arazzoSpec",
      "specAnchors": [
        "spec/arazzo/v1.1.0.html#xpath-conditions",
        "spec/arazzo/v1.1.0.html#expression-type-object",
        "spec/arazzo/v1.1.0.html#selector-object"
      ],
      "normativeLevels": ["MUST"],
      "claim": "XPath Criterion and Selector evaluation applies the declared version semantics and uses the default version when no Expression Type Object is present.",
      "status": "deviation",
      "owner": "ac-d45cd",
      "reason": "Version dispatch is delivered by ac-46638: explicit xpath-10 evaluates and every other declared or omitted version is rejected before evaluation. The residual deviation is the absence of an XPath 3.1 engine for the specification's omitted-version default, owned by ac-d45cd behind the ac-4c05c backend decision (epic ac-aeca8)."
    },
    {
      "id": "runtime.retry-limit-and-failure-fallthrough",
